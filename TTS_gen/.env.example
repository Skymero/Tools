# Copy to .env (ignored) and replace placeholders. Never commit real values.
DRIVE_INCOMING_FOLDER_ID=replace-me
DRIVE_FINISHED_FOLDER_ID=replace-me
DRIVE_GEMINI_OUTPUT_FOLDER_ID=replace-me
GOOGLE_OAUTH_CLIENT_FILE=%LOCALAPPDATA%\TTS_gen\secrets\client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=%LOCALAPPDATA%\TTS_gen\secrets\token.json
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=replace-me
LANGFLOW_API_KEY=replace-me
GEMINI_MODEL=replace-me
GEMINI_API_KEY=replace-me
GEMINI_TPM_LIMIT=replace-me
GEMINI_RPM_LIMIT=replace-me
GEMINI_RPD_LIMIT=replace-me
ENABLE_GEMINI_PLANNING=false
TTS_GEN_WORK_ROOT=work
TTS_GEN_OUTPUT_ROOT=output
TTS_GEN_DB_PATH=work\tts_gen.db
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
EXPORT_FULL_CHAPTER=true
EXPORT_VERTICAL_TEASER=false

